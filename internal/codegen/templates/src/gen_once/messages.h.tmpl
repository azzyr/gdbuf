    else if constexpr ( K == Kind::Uint32 )
        return pb_encode_varint( s, (uint32_t) static_cast<uint64_t>( v ) );
    else if constexpr ( K == Kind::Uint64 )
        return pb_encode_varint( s, static_cast<uint64_t>( v ) );
    else if constexpr ( K == Kind::Sint32 )
        return pb_encode_svarint( s, (int32_t) static_cast<int64_t>( v ) );
    else if constexpr ( K == Kind::Sint64 )
        return pb_encode_svarint( s, static_cast<int64_t>( v ) );
    else if constexpr ( K == Kind::Bool )
        return pb_encode_varint( s, static_cast<bool>( v ) ? 1 : 0 );
