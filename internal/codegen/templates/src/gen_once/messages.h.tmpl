template <Kind K, class T>
bool is_default( const T &v )
{
    if constexpr ( K == Kind::String || K == Kind::StringValue )
        return godot::String( v ).is_empty();
    else if constexpr ( K == Kind::Bytes || K == Kind::BytesValue )
        return godot::PackedByteArray( v ).is_empty();
    else if constexpr ( K == Kind::Float || K == Kind::Double || K == Kind::Duration || K == Kind::FloatValue || K == Kind::DoubleValue )
        return static_cast<double>( v ) == 0.0 && !std::signbit( static_cast<double>( v ) );
    else if constexpr ( K == Kind::Bool || K == Kind::BoolValue )
        return !static_cast<bool>( v );
    else
        return static_cast<int64_t>( v ) == 0;
}

// a tag and value for every kind except Message and Unsupported
