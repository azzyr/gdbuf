        return write_len( s, number, [&]( pb_ostream_t *o ) {
            return ( seconds == 0 || ( pb_encode_tag( o, PB_WT_VARINT, 1 ) && pb_encode_varint( o, (uint64_t) seconds ) ) ) &&
                   ( nanos == 0 || ( pb_encode_tag( o, PB_WT_VARINT, 2 ) && pb_encode_varint( o, (uint64_t) (int64_t) (int32_t) nanos ) ) );
        } );
