}

template <Kind KK, Kind VK, class VElem>
bool write_map( pb_ostream_t *s, uint32_t number, const godot::Dictionary &dict )
{
    godot::Array keys = dict.keys();
    for ( int64_t i = 0; i < keys.size(); i++ )
    {
        const godot::Variant key = keys[i];
        const godot::Variant value = dict[key];
        bool ok = write_len( s, number, [&]( pb_ostream_t *o ) {
            return write_entry_part<KK, void>( o, 1, key ) && write_entry_part<VK, VElem>( o, 2, value );
        } );
        if ( !ok )
            return false;
    }
    return true;
}

// ---- decoding

inline bool read_tag( pb_istream_t *s, uint32_t &number, pb_wire_type_t &wire )
{
    uint32_t tag;
    if ( !pb_decode_varint32( s, &tag ) )
        return false;
    number = tag >> 3;
    wire = (pb_wire_type_t) ( tag & 7 );
    if ( number == 0 )
        PB_RETURN_ERROR( s, "field number 0" );
    return true;
}

// runs field(sub, number, wire) for every field of a length-delimited submessage
template <class F>
bool read_sub( pb_istream_t *s, F &&field )
{
    pb_istream_t sub;
    if ( !pb_make_string_substream( s, &sub ) )
        return false;
    bool ok = true;
    while ( ok && sub.bytes_left > 0 )
    {
        uint32_t number;
        pb_wire_type_t wire;
        ok = read_tag( &sub, number, wire ) && field( &sub, number, wire );
    }
    if ( !ok )
    {
#ifndef PB_NO_ERRMSG
        s->errmsg = sub.errmsg;
#endif
        return false;
    }
    return pb_close_string_substream( s, &sub );
}

template <class M>
bool read_message( pb_istream_t *s, M &m, int depth )
{
    if ( depth >= max_depth )
        PB_RETURN_ERROR( s, "messages nested too deeply" );
    pb_istream_t sub;
    if ( !pb_make_string_substream( s, &sub ) )
        return false;
    if ( !m.decode_fields( &sub, depth + 1 ) )
    {
#ifndef PB_NO_ERRMSG
        s->errmsg = sub.errmsg;
#endif
        return false;
    }
    return pb_close_string_substream( s, &sub );
}

inline bool read_length( pb_istream_t *s, uint32_t &len )
{
    if ( !pb_decode_varint32( s, &len ) )
        return false;
    if ( len > s->bytes_left )
        PB_RETURN_ERROR( s, "length past end of input" );
    return true;
}

// the value of a field whose wire type already matched
template <Kind K>
bool read_value( pb_istream_t *s, decoded_t<K> &out )
{
    if constexpr ( K == Kind::Sint32 || K == Kind::Sint64 )
    {
        int64_t v;
        if ( !pb_decode_svarint( s, &v ) )
            return false;
        out = (decoded_t<K>) v;
    }
    else if constexpr ( K == Kind::Fixed32 || K == Kind::Sfixed32 || K == Kind::Float )
    {
        uint32_t v;
        if ( !pb_decode_fixed32( s, &v ) )
            return false;
        memcpy( &out, &v, 4 );
    }
    else if constexpr ( K == Kind::Fixed64 || K == Kind::Sfixed64 || K == Kind::Double )
    {
        uint64_t v;
        if ( !pb_decode_fixed64( s, &v ) )
            return false;
        memcpy( &out, &v, 8 );
    }
    else if constexpr ( wire_of( K ) == PB_WT_VARINT )
    {
        uint64_t v;
        if ( !pb_decode_varint( s, &v ) )
            return false;
        if constexpr ( K == Kind::Bool )
            out = v != 0;
        else
            out = (decoded_t<K>) v;
    }
    else if constexpr ( K == Kind::String || K == Kind::Bytes )
    {
        uint32_t len;
        if ( !read_length( s, len ) )
            return false;
        if ( len == 0 )
        {
            out = decoded_t<K>();
            return true;
        }
        godot::PackedByteArray b;
        b.resize( len );
        if ( !pb_read( s, b.ptrw(), len ) )
            return false;
        if constexpr ( K == Kind::Bytes )
            out = b;
        else if ( out.parse_utf8( (const char *) b.ptr(), len ) != godot::OK )
            PB_RETURN_ERROR( s, "string is not valid UTF-8" );
    }
    else if constexpr ( K == Kind::Timestamp || K == Kind::Duration )
    {
        int64_t seconds = 0, nanos = 0;
        bool ok = read_sub( s, [&]( pb_istream_t *sub, uint32_t number, pb_wire_type_t wire ) {
            uint64_t v;
            if ( wire != PB_WT_VARINT || number > 2 )
                return pb_skip_field( sub, wire );
            if ( !pb_decode_varint( sub, &v ) )
                return false;
            if ( number == 1 )
                seconds = (int64_t) v;
            else
                nanos = (int32_t) v;
            return true;
        } );
        if ( !ok )
            return false;
        if constexpr ( K == Kind::Timestamp )
            out = seconds * 1000 + (int64_t) std::floor( (double) nanos / 1e6 );
        else
            out = (double) seconds + (double) nanos / 1e9;
    }
    else if constexpr ( wrapped( K ) != Kind::Unsupported )
    {
        return read_sub( s, [&]( pb_istream_t *sub, uint32_t number, pb_wire_type_t wire ) {
            if ( number != 1 || wire != wire_of( wrapped( K ) ) )
                return pb_skip_field( sub, wire );
            return read_value<wrapped( K )>( sub, out );
        } );
    }
    return true;
}

// a singular field; a wrong wire type is skipped like an unknown field. hit reports whether it was read
template <Kind K, class T>
bool read_field( pb_istream_t *s, pb_wire_type_t wire, T &member, int depth, bool *hit = nullptr )
{
    if constexpr ( K == Kind::Unsupported )
        return pb_skip_field( s, wire );
    else
    {
        if ( wire != wire_of( K ) )
            return pb_skip_field( s, wire );
        if constexpr ( K == Kind::Message )
        {
            // a message seen again merges into the first
            if ( member.is_null() )
                member.instantiate();
            if ( !read_message( s, *member.ptr(), depth ) )
                return false;
        }
        else
        {
            decoded_t<K> v{};
            if ( !read_value<K>( s, v ) )
                return false;
            member = static_cast<T>( v );
        }
        if ( hit )
            *hit = true;
        return true;
    }
}

template <Kind K, class Elem>
bool read_repeated( pb_istream_t *s, pb_wire_type_t wire, godot::Array &arr, int depth )
{
    if constexpr ( K == Kind::Unsupported )
        return pb_skip_field( s, wire );
    else
    {
        if constexpr ( packable( K ) )
        {
            if ( wire == PB_WT_STRING )
            {
                pb_istream_t sub;
                if ( !pb_make_string_substream( s, &sub ) )
                    return false;
                while ( sub.bytes_left > 0 )
                {
                    decoded_t<K> v{};
                    if ( !read_value<K>( &sub, v ) )
                    {
#ifndef PB_NO_ERRMSG
                        s->errmsg = sub.errmsg;
#endif
                        return false;
                    }
                    arr.push_back( v );
                }
                return pb_close_string_substream( s, &sub );
            }
        }
        if ( wire != wire_of( K ) )
            return pb_skip_field( s, wire );
        if constexpr ( K == Kind::Message )
        {
            godot::Ref<Elem> e;
            e.instantiate();
            if ( !read_message( s, *e.ptr(), depth ) )
                return false;
            arr.push_back( e );
        }
        else
        {
            decoded_t<K> v{};
            if ( !read_value<K>( s, v ) )
                return false;
            arr.push_back( v );
        }
        return true;
    }
}

template <Kind KK, Kind VK, class VElem>
bool read_map( pb_istream_t *s, pb_wire_type_t wire, godot::Dictionary &dict, int depth )
{
    if ( wire != PB_WT_STRING )
        return pb_skip_field( s, wire );
    decoded_t<KK> key{};
    godot::Variant value;
    if constexpr ( VK == Kind::Message )
    {
        godot::Ref<VElem> m;
        m.instantiate();
        value = m;
    }
    else if constexpr ( VK != Kind::Unsupported )
        value = decoded_t<VK>{};
    bool ok = read_sub( s, [&]( pb_istream_t *sub, uint32_t number, pb_wire_type_t w ) {
        if ( number == 1 )
            return read_field<KK>( sub, w, key, depth );
        if ( number != 2 )
            return pb_skip_field( sub, w );
        if constexpr ( VK == Kind::Message )
        {
            godot::Ref<VElem> m = value;
            return read_field<VK>( sub, w, m, depth );
        }
        else if constexpr ( VK == Kind::Unsupported )
            return pb_skip_field( sub, w );
        else
        {
            decoded_t<VK> v{};
            bool hit = false;
            if ( !read_field<VK>( sub, w, v, depth, &hit ) )
                return false;
            if ( hit )
                value = v;
            return true;
        }
    } );
    if ( ok )
        dict[key] = value;
    return ok;
}

// ---- whole messages

// grows the output instead of sizing the whole message first, which would encode everything twice
inline bool append_bytes( pb_ostream_t *s, const pb_byte_t *buf, size_t count )
{
    godot::PackedByteArray &out = *(godot::PackedByteArray *) s->state;
    int64_t used = s->bytes_written;
    if ( used + (int64_t) count > out.size() )
        out.resize( std::max<int64_t>( out.size() * 2, used + count ) );
    memcpy( out.ptrw() + used, buf, count );
    return true;
}

template <class W>
godot::PackedByteArray encode( const W &w )
{
    godot::PackedByteArray out;
    out.resize( 256 );
    pb_ostream_t stream = { &append_bytes, &out, SIZE_MAX, 0 };
    if ( !w.encode_fields( &stream ) )
    {
        godot::UtilityFunctions::printerr( "gdbuf: encoding failed: ", PB_GET_ERROR( &stream ) );
        return godot::PackedByteArray();
    }
    out.resize( stream.bytes_written );
    return out;
}

// on failure the message is left cleared
template <class W>
godot::Error decode( W &w, const godot::PackedByteArray &bytes )
{
    w.clear_fields();
    pb_istream_t stream = pb_istream_from_buffer( bytes.ptr(), bytes.size() );
    if ( !w.decode_fields( &stream, 0 ) )
    {
        godot::UtilityFunctions::printerr( "gdbuf: decoding failed: ", PB_GET_ERROR( &stream ) );
        w.clear_fields();
        return godot::ERR_PARSE_ERROR;
    }
    return godot::OK;
}

inline godot::String display( const godot::Variant &v )
{
    if ( v.get_type() == godot::Variant::STRING )
    {
        return "\"" + godot::String( v ).c_escape() + "\"";
    }
    bool is_null_object = v.get_type() == godot::Variant::OBJECT && v.operator godot::Object *() == nullptr;
    if ( v.get_type() == godot::Variant::NIL || is_null_object )
    {
        return "null";
    }
    return godot::String( v );
}

