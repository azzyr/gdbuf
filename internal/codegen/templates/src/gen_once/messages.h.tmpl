    else if constexpr ( K == Kind::Float )
    {
        float x = (float) static_cast<double>( v );
        return pb_encode_fixed32( s, &x );
    }
    else if constexpr ( K == Kind::Double )
    {
        double x = static_cast<double>( v );
        return pb_encode_fixed64( s, &x );
