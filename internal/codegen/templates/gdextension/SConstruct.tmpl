#!/usr/bin/env python
import os

ARGUMENTS.setdefault("build_profile", "build_profile.json")
env = SConscript("godot-cpp/SConstruct")

env.Append(CPPPATH=["src", "nanopb"])
env.Append(CPPDEFINES=["PB_ENABLE_MALLOC"])
{{- range .ProtoData.Files }}
env.Append(CPPPATH=["src/{{ .Dir }}"])
{{- end }}

# godot-cpp sets c++17; the last -std flag wins
env.Append(CXXFLAGS=["/std:c++20" if env.get("is_msvc", False) else "-std=c++20"])

if env["platform"] == "web":
    env.Append(CCFLAGS=["-include", "stdlib.h"])

sources = [os.path.join(root, f) for root, _, files in os.walk("src") for f in files if f.endswith((".cpp", ".cc", ".c"))]
sources += ["nanopb/pb_common.c", "nanopb/pb_encode.c", "nanopb/pb_decode.c"]

library = env.SharedLibrary(
    "bin/{{ .GDExtensionName }}{}{}".format(env["suffix"], env["SHLIBSUFFIX"]), source=sources
)

Default(library)
